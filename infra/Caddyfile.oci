:80 {
	encode zstd gzip

	redir /admin /overview
	redir /admin/ /overview

	# 1. Cricit API & System Endpoints
	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /admin/v1/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /ready {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# 2. X-Train APIs & Portal (Dedicated paths and Host header)
	@xtrain host xtrain.*
	handle @xtrain {
		reverse_proxy xtrain_web_portal:4002
	}
	handle /api/gym/* {
		uri strip_prefix /api/gym
		reverse_proxy xtrain_cloud_backend:4000
	}
	handle /xtrain* {
		uri strip_prefix /xtrain
		reverse_proxy xtrain_web_portal:4002
	}

	# 3. Convenience redirect for /admin -> /overview
	redir /admin /overview
	redir /admin/ /overview

	# 4. Cricit Mobile Web App
	handle_path /app* {
		root * /srv/mobile-web
		file_server
		try_files {path} /index.html
	}

	# 5. Cricit Admin Newsroom (Default Root for all web features)
	handle {
		reverse_proxy admin:3000
	}
}
