# Cloudflare sits in front (proxied DNS, Full (strict) TLS). Caddy gets its own certs.
{
	email ops@cricit.app
}

api.cricit.app {
	encode zstd gzip
	reverse_proxy api:8000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}

admin.cricit.app {
	encode zstd gzip
	reverse_proxy admin:3000
}
