{
  "name": "cricit-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "keys": "node scripts/gen-keys.mjs",
    "types": "wrangler types",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@noble/hashes": "^2.4.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "otpauth": "^9.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
