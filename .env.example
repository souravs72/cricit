# Copy to .env and fill in. Never commit .env.
# `make keys` prints fresh JWT values for the three JWT_* lines.

# --- backend ---
ENV=local                       # local | test | staging | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://cricit:cricit@localhost:5432/cricit
REDIS_URL=redis://localhost:6379/0

JWT_KEY_ID=k1
JWT_PRIVATE_KEY=                # ES256 private key PEM, newlines as \n
JWT_PUBLIC_KEYS=                # "k1=<PEM>||k2=<PEM>" — every key still allowed to verify

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=      # base64 of the service-account JSON

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

YOUTUBE_API_KEY=                # restrict to the server IP in Google Cloud

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cricit-media
CDN_BASE_URL=

ADMIN_ORIGIN=http://localhost:3000
SENTRY_DSN=

# --- admin (server-side only; never NEXT_PUBLIC_) ---
API_BASE_URL=http://localhost:8000

# --- production postgres (docker-compose.prod.yml) ---
# POSTGRES_USER=cricit
# POSTGRES_PASSWORD=<long random>
# POSTGRES_DB=cricit
